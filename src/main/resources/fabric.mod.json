{
	"schemaVersion": 1,
	"id": "minecraft-place-mod",
	"version": "${version}",
	"name": "Minecraft Place Mod",
	"description": "A mod which promotes the /place command — makes /place structure-generated structures behave exactly like naturally generated ones (registered into StructureManager, persisted to chunk NBT).",
	"authors": [
		"ApTx2012"
	],
	"contact": {
		"homepage": "https://github.com/ApTx2012/Minecraft-place-mod",
		"sources": "https://github.com/ApTx2012/Minecraft-place-mod"
	},
	"license": "MIT",
	"icon": "assets/minecraft-place-mod/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.github.axtps.placemod.PlaceMod"
		]
	},
	"mixins": [
		"minecraft-place-mod.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}